{
  "name": "mae",
  "version": "1.0.0",
  "packageManager": "npm@11.19.0",
  "description": "Outpost: a small multi-agent harness on Claude. A Quartermaster plans and dispatches a crew of specialists, with memory, skills, scheduled jobs, and mission control, a page on your own machine.",
  "scripts": {
    "start": "tsx scripts/launch.ts",
    "cli": "tsx --import ./scripts/env.mjs src/camp.ts",
    "headless": "tsx --import ./scripts/env.mjs src/headless.ts",
    "watch": "tsx --import ./scripts/env.mjs src/watch.ts",
    "watch:install": "tsx scripts/watch-agent.ts",
    "watch:uninstall": "tsx scripts/watch-agent.ts --uninstall",
    "outpost": "tsx scripts/outpost.ts",
    "ui": "tsx --import ./scripts/env.mjs scripts/ui-dev.ts",
    "ui:serve": "tsx scripts/ui-build.ts --if-stale && tsx --import ./scripts/env.mjs src/server.ts",
    "ui:build": "tsx scripts/ui-build.ts",
    "build": "npm run typecheck && tsx scripts/ui-build.ts && tsx scripts/server-build.ts",
    "prod": "npm run build && npm run prod:start",
    "prod:start": "NODE_ENV=production node --import ./scripts/env.mjs dist/server.js",
    "test": "tsx --test --test-reporter=spec tests/*.test.ts && vitest run --config ui/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p ui && tsc --noEmit -p extension",
    "eval": "tsx --import ./scripts/env.mjs evals/run.ts",
    "extension:build": "tsx scripts/extension-build.ts",
    "extension:pack": "tsx scripts/extension-build.ts --zip",
    "tour:films": "tsx scripts/tour-films.ts",
    "site": "bash scripts/site.sh"
  },
  "keywords": [],
  "author": "Ryley Ameden",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.296",
    "@anthropic-ai/sdk": "^1.6.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "highlight.js": "^11.12.0",
    "node-pty": "^1.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "allowScripts": {
    "esbuild": false,
    "fsevents": false,
    "node-pty": false
  }
}
