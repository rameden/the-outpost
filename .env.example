# Outpost reads .env from the folder an outpost runs in: this checkout for Mae, and
# ~/Outposts/<name>/ for the others. Copy this file to .env and uncomment what you need.
# Nothing here is required on a Claude subscription. docs/configuration.md lists every variable.

# An Anthropic API key, for the API runtime. A key saved in Settings → Models is used first.
# ANTHROPIC_API_KEY=

# Pin the runtime: claude-code (your subscription) or api.
# CAMP_RUNTIME=claude-code

# The port, for an outpost started by itself (npm run ui). Started from the star chart, it uses
# the port in its camp/outpost.json instead.
# CAMP_PORT=4747

# HUB_PORT (the star chart's port) and OUTPOSTS_DIR (where other outposts are kept) are read from
# the shell, not from this file: HUB_PORT=4701 npm start

# The `claude` and `gh` to run, when they aren't on your PATH.
# CLAUDE_CODE_EXECUTABLE=/path/to/claude
# CAMP_GH=/path/to/gh

# Let your other machines at home reach this outpost. Plain HTTP: a home network you trust only.
# See docs/remote-access.md before turning it on.
# CAMP_LAN=1

# Secrets to pass to the crew's commands on purpose. Everything else that looks like one is left out.
# CAMP_SHELL_ENV_ALLOW=GH_TOKEN

# Read-aloud voices, without saving a key in Settings → Voice.
# ELEVENLABS_API_KEY=

# Skip plan approval (the crew starts on the Quartermaster's plan without asking).
# CAMP_APPROVE_PLANS=0
