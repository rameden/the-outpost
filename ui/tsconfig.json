{
  "compilerOptions": {
    "target": "es2022",
    "lib": [
      "es2023",
      "dom",
      "dom.iterable"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "types": [
      "node",
      "vite/client"
    ],
    "paths": {
      "@outpost/sdk": [
        "./src/plugins/sdk.ts"
      ]
    }
  },
  "include": [
    "src",
    "../plugins/*/src",
    "vite.config.ts"
  ]
}
