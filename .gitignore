node_modules/
.env
.env.*
!.env.example
.DS_Store

# camp/ is your personal camp state: the ledger, wiki, scheduled jobs, inbox, and quest log.
# It fills with your preferences and findings as you run expeditions, so it stays local.
camp/*
!camp/.gitkeep

# Eval results: one JSON file per run, local to you.
evals/results/

# Mission control's built page (`npm run ui` builds it from ui/src).
ui/dist/

# The camp server, built for production (`npm run prod` builds it from src/).
/dist/

# The Barnstorm browser extension, built (`npm run extension:build` builds it from extension/ and ui/src/egg).
extension/dist/
extension/*.zip

# A demo run's own state (its camp, token, sessions and forge), made when the demo is run.
demo/.instance/
